# ─────────────────────────────────────────────────────────────────────────────
# RosterFlow — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# ─── Supabase (required) ────────────────────────────────────────────────────
# Frontend-safe (exposed in browser bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── App URL ─────────────────────────────────────────────────────────────────
# Used for generating links in emails
VITE_APP_URL=http://localhost:5173

# ─── Server-only (Supabase Edge Function secrets — NOT prefixed VITE_) ───────
# Set these in Supabase Dashboard → Project Settings → Edge Functions → Secrets
# NEVER put these in .env for the frontend build
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Edge functions only
# RESEND_API_KEY=re_your_resend_api_key              # Edge functions only
# EMAIL_FROM=RosterFlow <noreply@yourdomain.com>     # Edge functions only
