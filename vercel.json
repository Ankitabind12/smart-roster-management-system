{
    "framework":  "vite",
    "rewrites":  [
                     {
                         "destination":  "/index.html",
                         "source":  "/((?!api/.*).*)"
                     }
                 ],
    "buildCommand":  "npm run build",
    "installCommand":  "npm install",
    "headers":  [
                    {
                        "headers":  [
                                        {
                                            "key":  "X-Content-Type-Options",
                                            "value":  "nosniff"
                                        },
                                        {
                                            "key":  "X-Frame-Options",
                                            "value":  "DENY"
                                        },
                                        {
                                            "key":  "X-XSS-Protection",
                                            "value":  "1; mode=block"
                                        }
                                    ],
                        "source":  "/(.*)"
                    }
                ],
    "outputDirectory":  "dist",
    "$schema":  "https://openapi.vercel.sh/vercel.json"
}
